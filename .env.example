# Copy to .env (gitignored) and fill in — or export as environment variables.
# Same convention as the Bruno collections
# (player-service/http/bruno-flows/.env.example): no real value is committed.

# ---------------------------------------------------------------------------
# FE target (required)
# ---------------------------------------------------------------------------
# local | dev | pr   — NO default: `dev` requires VPN (403 without it), while
#                      Amplify previews are publicly reachable.
FE_TARGET=
# Required when FE_TARGET=pr — the mono-fe PR number (its Amplify preview).
FE_PR=
# Escape hatch: any URL, ignores FE_TARGET/FE_PR.
# CYPRESS_BASE_URL=

# ---------------------------------------------------------------------------
# Mode (optional — defaults to mocked)
# ---------------------------------------------------------------------------
# mocked     = every business endpoint intercepted (no VPN, can gate a PR)
# integrated = real backend on dev/stg (requires VPN + the variables below)
CY_MODE=mocked

# ---------------------------------------------------------------------------
# CY_MODE=integrated only
# ---------------------------------------------------------------------------
# The public gateway the FE talks to (mono-fe's GATSBY_KTO_API).
KTO_API_URL=https://api.kto-dev.com
# The internal gateway — the only one routing /test-support/**. Requires VPN.
KTO_INTERNAL_API_URL=https://boapi.kto-dev.com

# The CPF used as the test identity. It has to be valid in the anti-fraud
# provider's (CAF/Legitimuz) sandbox WITH complete basic data (name/date of
# birth) — a CPF with no data there makes /registration/v4's enrichment fail,
# which looks like a test bug and isn't.
# One CPF per machine: you and a teammate running the same value at the same
# time will collide.
FLOW_TEST_CPF=

# The e-mail of that SAME existing test account, for specs that log in with
# an e-mail instead of a CPF (e.g. the legacy login's e-mail path) — not the
# epoch-derived e-mail freshIdentity() generates for a NEW registration, and
# not FLOW_TEST_EMAIL_DOMAIN below (that's just the domain). Keep it in sync
# with whatever e-mail the account behind FLOW_TEST_CPF actually has.
FLOW_TEST_LOGIN_EMAIL=

# Password for the disposable identities. Any strong value, but it must NOT be
# a substring of the generated e-mail (flow.<epoch>@<domain>) — so avoid
# "flow" and "kto".
FLOW_USER_PASSWORD=

# Domain of the test e-mails. Must be listed in the backend's
# registration.test-user-domains for the player to be born TEST_USER.
FLOW_TEST_EMAIL_DOMAIN=kto.com

# Shared secret of player-service's test-support endpoints (dev/stg only).
# AWS Secrets Manager -> /secret/player-service -> key test-support.api-key
TEST_SUPPORT_API_KEY=

# Same for kyc-service -> /secret/kyc-service
KYC_TEST_SUPPORT_API_KEY=
