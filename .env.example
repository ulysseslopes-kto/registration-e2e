# Copie para .env (gitignorado) e preencha — ou exporte como variáveis de ambiente.
# Mesmo padrão das collections Bruno (player-service/http/bruno-flows/.env.example):
# nenhum valor real commitado.

# ---------------------------------------------------------------------------
# Alvo do FE (obrigatório)
# ---------------------------------------------------------------------------
# local | dev | pr   — SEM default: dev exige VPN (403 fora dela);
#                      previews do Amplify sao publicamente alcancaveis
FE_TARGET=
# Obrigatório quando FE_TARGET=pr — número do PR do mono-fe (preview do Amplify).
FE_PR=
# Escape hatch: qualquer URL avulsa, ignora FE_TARGET/FE_PR.
# CYPRESS_BASE_URL=

# ---------------------------------------------------------------------------
# Modo (opcional — default: mocked)
# ---------------------------------------------------------------------------
# mocked     = backend de negócio 100% interceptado (sem VPN, roda em PR)
# integrated = backend real no dev/stg (exige VPN + as variáveis abaixo)
CY_MODE=mocked

# ---------------------------------------------------------------------------
# Somente CY_MODE=integrated
# ---------------------------------------------------------------------------
# Gateway público que o FE consome (GATSBY_KTO_API do mono-fe).
KTO_API_URL=https://api.kto-dev.com
# Gateway interno, único que expõe /test-support/** — exige VPN.
KTO_INTERNAL_API_URL=https://boapi.kto-dev.com

# CPF usado como identidade de teste. Precisa ser válido no sandbox do provider
# anti-fraude (CAF/Legitimuz) COM dados básicos completos (nome/DOB) — um CPF sem
# retorno completo faz o enrichment do /registration/v4 falhar e produz falha falsa.
# Um CPF por máquina: você e o Marco rodando o mesmo valor ao mesmo tempo colidem.
FLOW_TEST_CPF=

# Senha das identidades descartáveis. Qualquer valor forte, mas NÃO pode ser
# substring do e-mail gerado (flow.<epoch>@<domínio>) — evite "flow" e "kto".
FLOW_USER_PASSWORD=

# Domínio dos e-mails de teste. Precisa estar em registration.test-user-domains
# para o player nascer na categoria TEST_USER.
FLOW_TEST_EMAIL_DOMAIN=kto.com

# Segredo dos endpoints test-support do player-service (dev/stg only).
# AWS Secrets Manager -> /secret/player-service -> chave test-support.api-key
TEST_SUPPORT_API_KEY=

# Idem para o kyc-service -> /secret/kyc-service
KYC_TEST_SUPPORT_API_KEY=
