{
  "name": "registration-e2e",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "setup:aws": "bash scripts/setup-aws.sh",
    "typecheck": "tsc --noEmit",
    "precypress:open": "./scripts/check-env.sh",
    "cypress:open": "cypress open",
    "open:local:mocked": "./scripts/check-env.sh && FE_TARGET=local CY_MODE=mocked cypress open",
    "open:local:integrated": "./scripts/check-env.sh && FE_TARGET=local CY_MODE=integrated cypress open",
    "open:dev:mocked": "./scripts/check-env.sh && FE_TARGET=dev CY_MODE=mocked cypress open",
    "open:dev:integrated": "./scripts/check-env.sh && FE_TARGET=dev CY_MODE=integrated cypress open",
    "open:pr:mocked": "./scripts/check-env.sh && FE_TARGET=pr CY_MODE=mocked cypress open",
    "open:pr:integrated": "./scripts/check-env.sh && FE_TARGET=pr CY_MODE=integrated cypress open",
    "precypress:run": "./scripts/check-env.sh",
    "cypress:run": "cypress run"
  },
  "devDependencies": {
    "cypress": "^13.17.0",
    "typescript": "5.8.2"
  },
  "packageManager": "pnpm@10.15.0"
}
